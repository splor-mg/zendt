# GitHub token. `authentication` in the config (or -a) names this variable.
# Do not put the token itself in zendt.json.
GH_TOKEN=github_pat_...

# Path to a JSON or YAML config file.
# When CONFIG is set, SOURCES and FLOWS below are ignored.
CONFIG=other_config_file.json

# Inline config, used only when CONFIG is unset.
# SOURCES: one source object, or a JSON array of sources.
# FLOWS: optional JSON array of flows.
SOURCES='[{"id":"source_one","source":"https://github.com/user/rules_repo.git","authentication":"GH_TOKEN","version":"1.0.0"},{"id":"source_two","source":"home/sample/rules"}]'
FLOWS='[{"id":"financedata","description":"finance team flow for discount purposes","input":"data-raw/finance.csv.gz","rules":["student_discount","age_discount","other_discount"],"output":"data/finance.csv"}]'
